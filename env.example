SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*
CRON_TRIGGER_SECRET=your-cron-secret-here

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=PropRMS <noreply@example.com>

# Google OAuth & Drive Settings
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_PROJECT_ID=your-google-project-id

# Gmail API Settings (For django-gmailapi-backend)
GMAIL_API_CLIENT_ID=your-gmail-api-client-id
GMAIL_API_CLIENT_SECRET=your-gmail-api-client-secret
GMAIL_API_REFRESH_TOKEN=your-gmail-api-refresh-token

# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
